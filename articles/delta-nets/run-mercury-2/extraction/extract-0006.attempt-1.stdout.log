{"nodes":[{"kind":"definition","text":"A λ-term is a program made from variables, abstractions, and applications.","sourceUnitIds":["u000398"],"defines":["lambda-term"],"requires":[],"mentions":["variable","abstraction","application"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"In λx.t, the abstraction binds x in body t.","sourceUnitIds":["u000398"],"defines":["variable-binding"],"requires":["lambda-term"],"mentions":["abstraction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"In t u, t is the function and u is its argument.","sourceUnitIds":["u000398"],"defines":["function-application"],"requires":["lambda-term"],"mentions":["function","argument"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"β-redex and β-reduction","sourceUnitIds":["u000399"],"defines":["beta-redex","beta-reduction"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A β-redex is a function applied to an argument in the form (λx.t)u.","sourceUnitIds":["u000400"],"defines":["beta-redex"],"requires":["lambda-term","function-application"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"β-reduction substitutes u for the bound occurrences of x in t.","sourceUnitIds":["u000400"],"defines":["beta-reduction"],"requires":["beta-redex","variable-binding"],"mentions":["substitution"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Normal form and normalizing","sourceUnitIds":["u000401"],"defines":["normal-form","normalizing"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A normal form has no reducible pattern remaining.","sourceUnitIds":["u000402"],"defines":["normal-form"],"requires":["reduction"],"mentions":["reducible-pattern"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A term or net is normalizing if at least one reduction sequence eventually reaches normal form.","sourceUnitIds":["u000402"],"defines":["normalizing"],"requires":["normal-form","reduction-sequence"],"mentions":["term","net"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"qualification","text":"A normalizing term or net does not have to reach normal form in every system or along every reduction sequence.","sourceUnitIds":["u000402"],"defines":[],"requires":["normalizing"],"mentions":["reduction-system","reduction-sequence"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Interaction system","sourceUnitIds":["u000403"],"defines":["interaction-system"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An interaction system is a graph-rewriting system consisting of agent types and interaction rules.","sourceUnitIds":["u000404"],"defines":["interaction-system"],"requires":["graph-rewriting"],"mentions":["agent-type","interaction-rule"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"constraint","text":"An interaction rule applies only when two agents meet at their principal ports.","sourceUnitIds":["u000404"],"defines":[],"requires":["principal-port","agent"],"mentions":["interaction-rule"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Agent and port","sourceUnitIds":["u000405"],"defines":["agent","port"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An agent is a small node in a net.","sourceUnitIds":["u000406"],"defines":["agent"],"requires":["net"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A port is a connection socket on an agent.","sourceUnitIds":["u000406"],"defines":["port"],"requires":["agent"],"mentions":["connection"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Each agent has one principal port and zero or more auxiliary ports.","sourceUnitIds":["u000406"],"defines":["principal-port","auxiliary-port"],"requires":["agent","port"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Active pair","sourceUnitIds":["u000407"],"defines":["active-pair"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An active pair consists of two agents connected through their principal ports.","sourceUnitIds":["u000408"],"defines":["active-pair"],"requires":["agent","principal-port"],"mentions":["connection"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An active pair is exactly the local configuration rewritten by an interaction rule.","sourceUnitIds":["u000408"],"defines":[],"requires":["active-pair","interaction-rule"],"mentions":["graph-rewriting"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"One-step diamond","sourceUnitIds":["u000409"],"defines":["one-step-diamond"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A one-step diamond occurs when two different single interactions from the same net can be joined after one additional interaction on each result.","sourceUnitIds":["u000410"],"defines":["one-step-diamond"],"requires":["interaction","net"],"mentions":["reduction-path"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"constraint","text":"Every edge of a one-step diamond represents exactly one interaction step.","sourceUnitIds":["u000410"],"defines":[],"requires":["one-step-diamond"],"mentions":["interaction-step"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Perfect confluence","sourceUnitIds":["u000411"],"defines":["perfect-confluence"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Perfect confluence is the paper's name for the one-step diamond property of the interaction-system core.","sourceUnitIds":["u000412"],"defines":["perfect-confluence"],"requires":["one-step-diamond","interaction-system"],"mentions":["interaction-system-core"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Perfect confluence means that competing local interaction steps agree immediately.","sourceUnitIds":["u000412"],"defines":[],"requires":["perfect-confluence"],"mentions":["local-interaction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Church–Rosser confluence","sourceUnitIds":["u000413"],"defines":["church-rosser-confluence"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Church–Rosser confluence is the common-result property for reduction paths.","sourceUnitIds":["u000414"],"defines":["church-rosser-confluence"],"requires":["reduction-path"],"mentions":["common-result"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Church–Rosser confluence says that divergent valid reductions can be joined again, without requiring a one-step join.","sourceUnitIds":["u000414"],"defines":[],"requires":["church-rosser-confluence"],"mentions":["reduction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Canonical Δ-Net","sourceUnitIds":["u000415"],"defines":["canonical-delta-net"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A canonical Δ-Net is produced by translating a term to a net.","sourceUnitIds":["u000416"],"defines":["canonical-delta-net"],"requires":["term-to-net-translation"],"mentions":["lambda-term","net"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"constraint","text":"A canonical Δ-Net uses the special representation expected by the translation back to a λ-term.","sourceUnitIds":["u000416"],"defines":[],"requires":["canonical-delta-net","net-to-term-translation"],"mentions":["lambda-term"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Canonicalization","sourceUnitIds":["u000417"],"defines":["canonicalization"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Canonicalization is a cleanup rewrite that returns a proper intermediate net to canonical, term-like form.","sourceUnitIds":["u000418"],"defines":["canonicalization"],"requires":["proper-delta-net","canonical-delta-net"],"mentions":["cleanup-rewrite"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"contrast","text":"Canonicalization is not a core principal-port interaction.","sourceUnitIds":["u000418"],"defines":[],"requires":["canonicalization","principal-port-interaction"],"mentions":["core-interaction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Commutation","sourceUnitIds":["u000419"],"defines":["commutation"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Commutation is an interaction between distinct non-eraser agents.","sourceUnitIds":["u000420"],"defines":["commutation"],"requires":["interaction","agent"],"mentions":["eraser-agent"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"In commutation, each agent travels through the other and may be copied according to the other agent's arity.","sourceUnitIds":["u000420"],"defines":[],"requires":["commutation","arity"],"mentions":["copying"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Fan","sourceUnitIds":["u000421"],"defines":["fan"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A fan is a structural agent with two auxiliary ports.","sourceUnitIds":["u000422"],"defines":["fan"],"requires":["agent","auxiliary-port"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"In a rooted net, a fan can encode either an application or an abstraction.","sourceUnitIds":["u000422"],"defines":[],"requires":["fan","rooted-net"],"mentions":["application","abstraction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Fan annihilation expresses β-reduction.","sourceUnitIds":["u000422"],"defines":[],"requires":["fan","beta-reduction"],"mentions":["fan-annihilation"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Level and delta","sourceUnitIds":["u000423"],"defines":["level","delta"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"In a canonical λ encoding, entering an application's argument adds one level.","sourceUnitIds":["u000424"],"defines":["level"],"requires":["canonical-lambda-encoding","application"],"mentions":["argument"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Entering an application's function or an abstraction body does not add a level.","sourceUnitIds":["u000424"],"defines":[],"requires":["level","application","abstraction"],"mentions":["function","body"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A replicator port's delta equals the bound-variable occurrence level minus the replicator level.","sourceUnitIds":["u000424"],"defines":["replicator-delta"],"requires":["replicator","level","variable-binding"],"mentions":["bound-variable-occurrence"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Proper Δ-Net","sourceUnitIds":["u000425"],"defines":["proper-delta-net"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A proper Δ-Net is reachable from a canonical Δ-Net through zero or more core Δ interactions.","sourceUnitIds":["u000426"],"defines":["proper-delta-net"],"requires":["canonical-delta-net","delta-interaction"],"mentions":["reachability"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"qualification","text":"A proper Δ-Net may contain noncanonical intermediate shapes.","sourceUnitIds":["u000426"],"defines":[],"requires":["proper-delta-net"],"mentions":["noncanonical-shape"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Replicator","sourceUnitIds":["u000427"],"defines":["replicator"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A replicator is a variable-arity agent used for sharing.","sourceUnitIds":["u000428"],"defines":["replicator"],"requires":["agent","sharing"],"mentions":["variable-arity"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A replicator has a level and an integer delta for each auxiliary port.","sourceUnitIds":["u000428"],"defines":["replicator-level","replicator-delta"],"requires":["replicator","level","delta","auxiliary-port"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Sharing scope","sourceUnitIds":["u000429"],"defines":["sharing-scope"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A sharing scope is the region controlled by one duplication context.","sourceUnitIds":["u000430"],"defines":["sharing-scope"],"requires":["duplication-context"],"mentions":["region"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"historical-note","text":"Older interaction-net approaches often marked sharing-scope boundaries with separate delimiter agents.","sourceUnitIds":["u000430"],"defines":[],"requires":["sharing-scope","agent"],"mentions":["interaction-net","delimiter-agent"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Leftmost-outermost","sourceUnitIds":["u000431"],"defines":["leftmost-outermost"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"procedure","text":"Leftmost-outermost reduction first chooses a reducible pattern that is not nested inside another reducible pattern.","sourceUnitIds":["u000432"],"defines":["leftmost-outermost"],"requires":["reducible-pattern","nesting"],"mentions":["reduction-priority"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"procedure","text":"After choosing an outermost pattern, leftmost-outermost reduction chooses the leftmost such pattern in the term-like reading of the net.","sourceUnitIds":["u000432"],"defines":[],"requires":["leftmost-outermost","term-like-reading"],"mentions":["net"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Primary source","sourceUnitIds":["u000433"],"defines":["primary-source"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"citation","text":"The primary source is Daniel Augusto Rizzi Salvadori's paper “Δ-Nets: Interaction-Based System for Optimal Parallel λ-Reduction,” arXiv:2505.20314v4, dated 22 July 2026.","sourceUnitIds":["u000434"],"defines":["primary-source"],"requires":[],"mentions":["delta-nets","optimal-parallel-lambda-reduction","arxiv"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"source-link","text":"The HTML version of the primary source is available on arXiv.","sourceUnitIds":["u000435"],"defines":[],"requires":["primary-source"],"mentions":["arxiv-html"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"source-link","text":"The arXiv abstract and downloadable formats are available online.","sourceUnitIds":["u000436"],"defines":[],"requires":["primary-source"],"mentions":["arxiv-abstract"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"qualification","text":"This edition is an independently structure