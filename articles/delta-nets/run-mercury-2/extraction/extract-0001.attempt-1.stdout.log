{"nodes":[{"kind":"navigation","text":"The page provides a link to the guide section.","sourceUnitIds":["u000001"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"identity","text":"The author is Christos Chatzifountas.","sourceUnitIds":["u000002"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"navigation","text":"The site links to About, Work, Notebook, and Contact sections.","sourceUnitIds":["u000003"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"description","text":"The page is a reader-first technical explainer.","sourceUnitIds":["u000004"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"topic","text":"The guide is titled Δ-Nets.","sourceUnitIds":["u000005"],"defines":["Δ-Nets"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"description","text":"The guide explains an interaction-based proposal for optimal parallel lambda reduction, using diagrams before notation.","sourceUnitIds":["u000006"],"defines":["optimal parallel lambda reduction"],"requires":[],"mentions":["interaction-based proposal"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"source_reference","text":"The guide is based on Daniel Augusto Rizzi Salvadori’s paper, arXiv:2505.20314v4.","sourceUnitIds":["u000007"],"defines":[],"requires":[],"mentions":["Daniel Augusto Rizzi Salvadori","arXiv:2505.20314v4"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"interface","text":"The page includes a reading-size control.","sourceUnitIds":["u000008"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"interface","text":"The reading-size control offers A, A+, and A++ settings.","sourceUnitIds":["u000009"],"defines":[],"requires":[],"mentions":["reading-size control"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"interface","text":"The page includes an appearance control.","sourceUnitIds":["u000010"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"interface","text":"The appearance control offers dark mode.","sourceUnitIds":["u000011"],"defines":[],"requires":[],"mentions":["appearance control"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"navigation","text":"The page provides a contents section for the guide.","sourceUnitIds":["u000012"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 00 explains how to read the guide.","sourceUnitIds":["u000013"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 01 presents the problem to solve.","sourceUnitIds":["u000014"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 02 moves from terms to interactions.","sourceUnitIds":["u000015"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 03 introduces the three-agent core.","sourceUnitIds":["u000016"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 04 discusses what happens when agents meet.","sourceUnitIds":["u000017"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 05 explains how to encode a lambda term.","sourceUnitIds":["u000018"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 05a traces a lambda term.","sourceUnitIds":["u000019"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 06 explains reduction discipline.","sourceUnitIds":["u000020"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 07 states what the proposal claims.","sourceUnitIds":["u000021"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"Section 08 contains a glossary and source information.","sourceUnitIds":["u000022"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"scope","text":"The guide rearranges the paper’s argument for learning and uses original diagrams.","sourceUnitIds":["u000023"],"defines":[],"requires":[],"mentions":["paper’s argument","original diagrams"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"scope","text":"The paper remains authoritative for definitions and proofs.","sourceUnitIds":["u000023"],"defines":[],"requires":[],"mentions":["definitions","proofs"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"The guide introduces notation after an initial orientation.","sourceUnitIds":["u000024"],"defines":[],"requires":[],"mentions":["notation"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Δ-Nets is a proposed graph-rewriting model.","sourceUnitIds":["u000025"],"defines":["Δ-Nets","graph-rewriting model"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"procedure","text":"To use the model, convert a program into a graph of small nodes and wires, then repeatedly replace small matching graph pieces.","sourceUnitIds":["u000025"],"defines":[],"requires":["graph-rewriting model"],"mentions":["nodes","wires"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"The model aims for optimal parallel reduction by avoiding work that will later be discarded and reducing necessary work once even when an expression has multiple uses.","sourceUnitIds":["u000025"],"defines":[],"requires":["parallel reduction"],"mentions":["sharing","discarded work"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"principle","text":"A program is built as a net of very small agents.","sourceUnitIds":["u000027"],"defines":["agent"],"requires":[],"mentions":["net"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"principle","text":"Local pairs of agents can interact independently.","sourceUnitIds":["u000027"],"defines":[],"requires":["agent"],"mentions":["local interaction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"principle","text":"Sharing is represented directly in the graph rather than in a separate copy table.","sourceUnitIds":["u000027"],"defines":[],"requires":["sharing"],"mentions":["graph"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"caveat","text":"The paper claims optimality and confluence guarantees for the proposal.","sourceUnitIds":["u000029"],"defines":["confluence"],"requires":[],"mentions":["optimality"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"caveat","text":"The guide teaches the design, while the paper retains the definitions and proofs.","sourceUnitIds":["u000029"],"defines":[],"requires":[],"mentions":["design","definitions","proofs"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"The guide lists six prerequisite ideas before Chapter 1.","sourceUnitIds":["u000030"],"defines":[],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A lambda term is a small functional program.","sourceUnitIds":["u000032"],"defines":["lambda term"],"requires":[],"mentions":["functional program"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"The expression λx.t denotes a function with parameter x and body t.","sourceUnitIds":["u000032"],"defines":[],"requires":["lambda term"],"mentions":["function","parameter","body"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"The expression t u denotes applying t to u.","sourceUnitIds":["u000032"],"defines":["application"],"requires":["lambda term"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An occurrence of x is bound when a surrounding λx owns it.","sourceUnitIds":["u000034"],"defines":["bound variable"],"requires":["lambda term"],"mentions":["scope"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An occurrence is free when no surrounding abstraction owns it.","sourceUnitIds":["u000034"],"defines":["free variable"],"requires":["lambda term","abstraction"],"mentions":["scope"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Levels track nested abstractions.","sourceUnitIds":["u000036"],"defines":["levels"],"requires":["abstraction"],"mentions":["nested abstractions"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A level shift adds a delta cost when a variable crosses a lambda.","sourceUnitIds":["u000036"],"defines":["delta"],"requires":["levels","variable"],"mentions":["lambda"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Levels and deltas track scopes without global lookups.","sourceUnitIds":["u000036"],"defines":[],"requires":["levels","delta","scope"],"mentions":["global lookup"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"The first chapter introduces the motivation.","sourceUnitIds":["u000037"],"defines":[],"requires":[],"mentions":["motivation"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"problem","text":"The central problem is wasted work.","sourceUnitIds":["u000038"],"defines":[],"requires":[],"mentions":["wasted work"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"problem","text":"Ordinary lambda calculus is compact but leaves open what to do when a variable is unused or appears multiple times.","sourceUnitIds":["u000039"],"defines":[],"requires":["lambda calculus"],"mentions":["variable use"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"The mechanics section introduces connections.","sourceUnitIds":["u000040"],"defines":[],"requires":[],"mentions":["connections"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Interaction nets model lambda terms as wiring.","sourceUnitIds":["u000042"],"defines":["interaction nets"],"requires":["lambda term"],"mentions":["wiring"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A lambda node has a binding port for the parameter and a body port for the expression.","sourceUnitIds":["u000042"],"defines":["lambda node","binding port","body port"],"requires":["lambda term","port"],"mentions":["variables"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Variable distribution determines the logic of the wiring.","sourceUnitIds":["u000042"],"defines":[],"requires":["variable distribution"],"mentions":["wiring"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"notation","text":"The delta symbol denotes Δ.","sourceUnitIds":["u000043"],"defines":["Δ"],"requires":[],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"explanation","text":"A delta represents the cost of crossing a scope.","sourceUnitIds":["u000045"],"defines":[],"requires":["scope","delta"],"mentions":["cost"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"explanation","text":"When a variable moves from one lambda into another, its depth increases.","sourceUnitIds":["u000045"],"defines":[],"requires":["variable","lambda","depth"],"mentions":["scope"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Deltas let the interaction net locate variables without scanning the code.","sourceUnitIds":["u000045"],"defines":[],"requires":["delta","interaction net"],"mentions":["variable location","code scanning"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"procedure","text":"When an application node meets a lambda abstraction, the two nodes interact.","sourceUnitIds":["u000047"],"defines":[],"requires":["application","lambda abstraction"],"mentions":["interaction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"procedure","text":"The lambda node’s binding port determines whether to replicate the variable or erase it.","sourceUnitIds":["u000047"],"defines":[],"requires":["binding port"],"mentions":["Replicator node","erasure"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A redex is a subexpression that can be simplified immediately.","sourceUnitIds":["u000049"],"defines":["redex"],"requires":[],"mentions":["simplification"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"example","text":"A function positioned next to its argument is a redex.","sourceUnitIds":["u000049"],"defines":[],"requires":["redex"],"mentions":["function","argument"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A reduction is one simplification step.","sourceUnitIds":["u000049"],"defines":["reduction"],"requires":["redex"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A term or net is in normal form when no remaining part can fire.","sourceUnitIds":["u000051"],"defines":["normal form"],"requires":["term","net"],"mentions":["firing"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Normalizing means reaching normal form through some sequence of steps.","sourceUnitIds":["u000051"],"defines":["normalizing"],"requires":["normal form"],"mentions":["reduction steps"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"The substitution view describes lambda reduction by replacing variables with arguments.","sourceUnitIds":["u000052"],"defines":["substitution view"],"requires":[],"mentions":["lambda reduction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"equation","text":null,"sourceUnitIds":["u000053"],"defines":["lambda substitution"],"requires":["lambda term","application"],"mentions":["beta reduction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"transition","text":"The substitution rule conceals two important edge cases that motivate the paper.","sourceUnitIds":["u000054"],"defines":[],"requires":["substitution"],"mentions":["edge cases"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"topic","text":"Erasure is one edge case of substitution.","sourceUnitIds":["u000055"],"defines":["erasure"],"requires":["substitution"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"problem","text":"If the body t never mentions x, the argument u disappears.","sourceUnitIds":["u000057"],"defines":[],"requires":["erasure"],"mentions":["unused variable"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Work performed inside an argument that is later erased is wasted.","sourceUnitIds":["u000057"],"defines":[],"requires":["erasure"],"mentions":["wasted work"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"topic","text":"Sharing is the other edge case of substitution.","sourceUnitIds":["u000058"],"defines":["sharing"],"requires":["substitution"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"problem","text":"If x occurs more than once, naive substitution copies u.","sourceUnitIds":["u000060"],"defines":[],"requires":["sharing"],"mentions":["naive substitution"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"problem","text":"If the copied argument still contains redexes, the same necessary work may be repeated in every copy.","sourceUnitIds":["u000060"],"defines":[],"requires":["redex","sharing"],"mentions":["duplicated reduction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"The paper organizes lambda calculus fragments by variable-use rules.","sourceUnitIds":["u000061"],"defines":[],"requires":[],"mentions":["lambda calculus"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A bound variable is an occurrence owned by a surrounding lambda.","sourceUnitIds":["u000062"],"defines":["bound variable"],"requires":["lambda"],"mentions":["λx.x"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"example","text":"In λx.x, the occurrence of x is bound by the surrounding lambda.","sourceUnitIds":["u000062"],"defines":[],"requires":["bound variable"],"mentions":["λx.x"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"The linear calculus requires every bound variable to occur exactly once.","sourceUnitIds":["u000062"],"defines":["linear calculus"],"requires":["bound variable"],"mentions":["variable-use rules"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"λL is the linear fragment in which each bound variable occurs exactly once.","sourceUnitIds":["u000064"],"defines":["λL","linear"],"requires":["bound variable"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"notation","text":"An arrow links the variable-use fragments in the guide’s diagram.","sourceUnitIds":["u000065"],"defines":[],"requires":[],"mentions":["variable-use fragments"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"λA is the affine fragment in which a bound variable occurs once or not at all.","sourceUnitIds":["u000067"],"defines":["λA","affine"],"requires":["bound variable"],"mentions":["erasure"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"λI is the relevant fragment in which a bound variable occurs at least once.","sourceUnitIds":["u000069"],"defines":["λI","relevant"],"requires":["bound variable"],"mentions":["sharing"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"notation","text":"A diagonal arrow links the relevant and full fragments in the guide’s diagram.","sourceUnitIds":["u000070"],"defines":[],"requires":[],"mentions":["variable-use fragments"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"λK is the full fragment allowing any number of appearances of a bound variable.","sourceUnitIds":["u000072"],"defines":["λK","full"],"requires":["bound variable"],"mentions":["erasure","sharing"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"The paper defines ΔL, ΔA, ΔI, and ΔK as corresponding Δ-Net subsystems.","sourceUnitIds":["u000073"],"defines":["ΔL","ΔA","ΔI","ΔK"],"requires":["Δ-Net","λL","λA","λI","λK"],"mentions":["subsystems"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"The guide explains why reduction order alone cannot solve duplication.","sourceUnitIds":["u000074"],"defines":[],"requires":[],"mentions":["reduction order"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"A reduction order chooses which redex to simplify next.","sourceUnitIds":["u000075"],"defines":["reduction order"],"requires":["redex"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"For erasure, normal order can avoid reducing an argument that will be discarded.","sourceUnitIds":["u000075"],"defines":["normal order"],"requires":["erasure","reduction order"],"mentions":["outermost application"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Some shared terms have no ordinary sequential reduction order that avoids every duplicated reduction.","sourceUnitIds":["u000075"],"defines":[],"requires":["sharing","reduction order"],"mentions":["Lévy"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"notation","text":"The guide marks a limitation or difficulty in the reduction-order discussion.","sourceUnitIds":["u000076"],"defines":[],"requires":[],"mentions":["reduction order"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"design_target","text":"The design target is to represent sharing directly in the graph.","sourceUnitIds":["u000078"],"defines":[],"requires":["sharing","graph"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"design_target","text":"A shared subgraph should be reduced once so every use observes the result.","sourceUnitIds":["u000078"],"defines":[],"requires":["shared subgraph"],"mentions":["reduction"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"outline","text":"The second chapter shifts the model from trees to interactions.","sourceUnitIds":["u000079"],"defines":[],"requires":[],"mentions":["model shift"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"The guide argues that programs should not be treated as trees.","sourceUnitIds":["u000080"],"defines":[],"requires":[],"mentions":["syntax tree"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"The paper replaces a sequential substitution machine with an interaction system.","sourceUnitIds":["u000081"],"defines":["interaction system"],"requires":["substitution machine"],"mentions":["sequential substitution"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An interaction system is a graph whose small local rewrites can occur independently.","sourceUnitIds":["u000081"],"defines":["local rewrite","independent rewrite"],"requires":["interaction system"],"mentions":["graph"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"transition","text":"The guide next defines what local and independent mean in this system.","sourceUnitIds":["u000081"],"defines":[],"requires":["local rewrite","independent rewrite"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Graphs make sharing visible.","sourceUnitIds":["u000082"],"defines":[],"requires":[],"mentions":["sharing"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"contrast","text":"A syntax tree represents every occurrence as a separate copy.","sourceUnitIds":["u000083"],"defines":[],"requires":["syntax tree"],"mentions":["copy"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"A graph can connect multiple uses to one shared subgraph.","sourceUnitIds":["u000083"],"defines":["shared subgraph"],"requires":["graph"],"mentions":["connected piece"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Computing a shared graph piece once allows it to be reused.","sourceUnitIds":["u000083"],"defines":[],"requires":["shared subgraph"],"mentions":["reuse"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"Textual substitution duplicates work for separate uses.","sourceUnitIds":["u000084"],"defines":[],"requires":["textual substitution"],"mentions":["duplication"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"code","text":null,"sourceUnitIds":["u000085"],"defines":[],"requires":["textual substitution"],"mentions":["uses","arguments","work"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"A graph representation connects multiple uses through sharing.","sourceUnitIds":["u000086"],"defines":[],"requires":["graph representation"],"mentions":["sharing"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"code","text":null,"sourceUnitIds":["u000087"],"defines":[],"requires":["graph representation"],"mentions":["uses","shared argument"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"A graph preserves one identity for multiple uses while rewriting.","sourceUnitIds":["u000088"],"defines":[],"requires":["graph","sharing"],"mentions":["identity"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Δ-Nets is one local method for managing shared identity during graph rewriting.","sourceUnitIds":["u000088"],"defines":[],"requires":["Δ-Nets","graph rewriting"],"mentions":["shared identity"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"The guide gives a short introduction to interaction systems.","sourceUnitIds":["u000089"],"defines":[],"requires":[],"mentions":["interaction system"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An interaction system consists of agents and interaction rules.","sourceUnitIds":["u000090"],"defines":["interaction rule"],"requires":["interaction system"],"mentions":["agents"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"An agent is a small node with sockets called ports.","sourceUnitIds":["u000090"],"defines":["agent","port"],"requires":["node"],"mentions":["sockets"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"The principal port is the distinguished port that can initiate a rewrite.","sourceUnitIds":["u000090"],"defines":["principal port"],"requires":["port","rewrite"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Auxiliary ports carry surrounding wiring through a rewrite.","sourceUnitIds":["u000090"],"defines":["auxiliary port"],"requires":["port","rewrite"],"mentions":["wiring"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"definition","text":"Two agents meeting principal-to-principal form an active pair.","sourceUnitIds":["u000091"],"defines":["active pair"],"requires":["principal port","agent"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"procedure","text":"An interaction rule rewrites an active pair by reconnecting only the wires attached at that location.","sourceUnitIds":["u000091"],"defines":[],"requires":["active pair","interaction rule"],"mentions":["local wires"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"The active pair and its nearby wires are the complete input to the rule.","sourceUnitIds":["u000091"],"defines":[],"requires":["active pair","interaction rule"],"mentions":["locality"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"step","text":"The first step is to find an active pair.","sourceUnitIds":["u000092","u000093"],"defines":[],"requires":["active pair"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"constraint","text":"Only a principal-to-principal wire counts as an active pair.","sourceUnitIds":["u000094"],"defines":[],"requires":["principal port","active pair"],"mentions":["local decision"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"step","text":"The second step is to apply the active pair’s local rule.","sourceUnitIds":["u000095","u000096"],"defines":[],"requires":["active pair","interaction rule"],"mentions":["local rewrite"],"fills":[],"need":"","gapType":null,"origin":"source"}],"edges":[{"from":24,"to":25,"relation":"elaborates"},{"from":25,"to":26,"relation":"enables"},{"from":26,"to":27,"relation":"elaborates"},{"from":27,"to":28,"relation":"enables"},{"from":31,"to":32,"relation":"defines"},{"from":31,"to":33,"relation":"defines"},{"from":32,"to":34,"relation":"defines"},{"from":35,"to":36,"relation":"defines"},{"from":36,"to":37,"relation":"enables"},{"from":40,"to":41,"relation":"defines"},{"from":41,"to":42,"relation":"elaborates"},{"from":43,"to":44,"relation":"defines"},{"from":46,"to":47,"relation":"enables"},{"from":48,"to":49,"relation":"defines"},{"from":48,"to":50,"relation":"defines"},{"from":51,"to":52,"relation":"elaborates"},{"from":53,"to":54,"relation":"precedes"},{"from":54,"to":55,"relation":"elaborates"},{"from":55,"to":56,"relation":"elaborates"},{"from":58,"to":59,"relation":"elaborates"},{"from":60,"to":61,"relation":"defines"},{"from":61,"to":63,"relation":"elaborates"},{"from":61,"to":65,"relation":"elaborates"},{"from":61,"to":67,"relation":"elaborates"},{"from":61,"to":69,"relation":"elaborates"},{"from":61,"to":71,"relation":"elaborates"},{"from":62,"to":64,"relation":"defines"},{"from":66,"to":68,"relation":"contrasts"},{"from":68,"to":70,"relation":"contrasts"},{"from":70,"to":72,"relation":"contrasts"},{"from":72,"to":73,"relation":"defines"},{"from":74,"to":75,"relation":"elaborates"},{"from":75,"to":77,"relation":"enables"},{"from":77,"to":78,"relation":"enables"},{"from":79,"to":80,"relation":"elaborates"},{"from":80,"to":81,"relation":"enables"},{"from":81,"to":82,"relation":"elaborates"},{"from":82,"to":83,"relation":"enables"},{"from":83,"to":84,"relation":"contrasts"},{"from":84,"to":85,"relation":"exemplifies"},{"from":83,"to":86,"relation":"contrasts"},{"from":86,"to":87,"relation":"exemplifies"},{"from":87,"to":88,"relation":"supports"},{"from":89,"to":90,"relation":"defines"},{"from":90,"to":91,"relation":"enables"},{"from":91,"to":92,"relation":"enables"},{"from":92,"to":93,"relation":"precedes"},{"from":93,"to":94,"relation":"enables"},{"from":94,"to":95,"relation":"precedes"}],"evidenceFrames":[{"claim":28,"evidence":[29],"warrantGap":null,"limitations":[29]},{"claim":39,"evidence":[57,60],"warrantGap":null,"limitations":[]},{"claim":77,"evidence":[75],"warrantGap":null,"limitations":[]},{"claim":81,"evidence":[83,85,87],"warrantGap":null,"limitations":[]},{"claim":88,"evidence":[87],"warrantGap":null,"limitations":[]},{"claim":90,"evidence":[91],"warrantGap":null,"limitations":[]},{"claim":91,"evidence":[94],"warrantGap":null,"limitations":[]}]}
