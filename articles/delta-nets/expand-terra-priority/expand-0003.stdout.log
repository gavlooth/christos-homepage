{"items":[{"targetId":"n0000252","injections":[{"type":"interpretation","text":"Replication preserves the replicated agent’s structure while allowing each outgoing copy to carry the level required by its destination context.","densityScore":0.82,"relation":"elaborates","reason":"Makes the copy-versus-level distinction operational."}]},{"targetId":"n0000258","injections":[{"type":"warrant","text":"Canonical translation makes net comparison meaningful because syntactically identical term structure is not left to arbitrary wiring choices.","densityScore":0.76,"relation":"supports","reason":"Explains why the one-to-one translation property matters."}]},{"targetId":"n0000305","injections":[{"type":"mechanism","text":"A node’s level equals the number of application-argument edges on the path from the term root to that node.","densityScore":0.88,"relation":"elaborates","reason":"Compresses the recursive level rules into a path invariant."}]},{"targetId":"n0000321","injections":[{"type":"mechanism","text":"The delta on a bound-use port is computed once during translation and remains attached to that specific exit as the net rewrites.","densityScore":0.75,"relation":"elaborates","reason":"Connects initial port annotation to later replication behavior."}]},{"targetId":"n0000343","injections":[{"type":"warrant","text":"Because each replicator exit carries its own relative adjustment, scope-context information travels with replication instead of requiring separate delimiter nodes in the net.","densityScore":0.84,"relation":"supports","reason":"States the architectural consequence of level-delta bookkeeping."}]}]}
