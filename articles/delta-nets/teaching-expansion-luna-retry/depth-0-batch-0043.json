      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "When two replicators are merged, the levels of their external endpoints are preserved.",
          "requires": [
            "replicator",
            "external endpoint level"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "After the merge, deltas are recomputed relative to the level of the replicator that survives.",
          "requires": [
            "replicator",
            "delta",
            "surviving replicator level"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0001097",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "In ΔK, unpaired replicator ports can be removed when they lead directly to erasers.",
          "requires": [
            "ΔK",
            "replicator port",
            "unpaired port"
          ],
          "citationRequired": false
        },
        {
          "role": "limitation",
          "basis": "source",
          "text": "The removal rule applies only when the replicator port is unpaired and leads directly to an eraser.",
          "requires": [
            "replicator port",
            "unpaired port",
            "eraser"
          ],
          "citationRequired": false
        }
      ]
    }
