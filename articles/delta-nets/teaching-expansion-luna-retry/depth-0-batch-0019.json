      "units": [
        {
          "role": "definition",
          "basis": "common_knowledge",
          "text": "A wire is a direct connection that carries structure or signals without applying a transformation.",
          "requires": [],
          "citationRequired": false
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "A remaining one-port replicator with zero delta collapses to a wire.",
          "requires": [],
          "citationRequired": true
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "After this collapse, the remaining replicator is represented as a direct wire connection.",
          "requires": [],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000794",
      "units": [
        {
          "role": "definition",
          "basis": "common_knowledge",
          "text": "Canonicalization normalizes equivalent representations into a standard form.",
          "requires": [],
          "citationRequired": false
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "Canonicalization is not limited to principal-to-principal port pairs.",
          "requires": [],
          "citationRequired": true
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "This ability includes modifying ports outside the principal-to-principal pairs.",
          "requires": [],
          "citationRequired": true
        }
      ]
    }
  ]
