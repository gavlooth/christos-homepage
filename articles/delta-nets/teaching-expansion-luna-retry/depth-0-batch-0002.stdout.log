{"items":[{"recordId":"teach-n0000692","units":[{"role":"statement","basis":"source","text":"Equal replicators must match in level and arity.","requires":["replicator","level","arity"],"citationRequired":false},{"role":"statement","basis":"source","text":"Equal replicators must match in the port delta for every port.","requires":["replicator","port delta"],"citationRequired":false}]},{"recordId":"teach-n0000693","units":[{"role":"definition","basis":"common_knowledge","text":"A λ-term is a formal expression in the lambda calculus, and a translation maps such an expression into another representation.","requires":[],"citationRequired":false},{"role":"definition","basis":"common_knowledge","text":"A translation is well-formed when its result satisfies the validity conditions of the target representation.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"For well-formed λ-term translations, active replicators at the same level are equal.","requires":["active replicator","level"],"citationRequired":false},{"role":"statement","basis":"source","text":"The equality result applies specifically to active replicators that occupy the same level.","requires":["active replicator","level"],"citationRequired":false}]}]}
