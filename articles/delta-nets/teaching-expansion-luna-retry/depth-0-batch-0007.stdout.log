{"items":[{"recordId":"teach-n0000726","units":[{"role":"statement","basis":"source","text":"A hand-built net is valid only when the connected components have matching arity and matching levels.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"Matching levels and arity is not sufficient: every port delta must also match between the connected components.","requires":["arity","level","port delta"],"citationRequired":false}]},{"recordId":"teach-n0000727","units":[{"role":"statement","basis":"common_knowledge","text":"A replicator is an operation that copies or distributes one value across multiple connections in a net.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"The relevant case is when the levels of the two structures differ.","requires":["level"],"citationRequired":false},{"role":"mechanism","basis":"source","text":"When the levels differ, the replicators commute rather than annihilate: changing their order leaves the result unchanged, and they do not cancel each other.","requires":["commutativity","replicator"],"citationRequired":false}]}]}
