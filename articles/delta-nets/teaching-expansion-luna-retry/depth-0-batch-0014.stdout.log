{"items":[{"recordId":"teach-n0000769","units":[{"role":"statement","basis":"source","text":"The inner application keeps g at level 1.","requires":[],"citationRequired":true},{"role":"statement","basis":"source","text":"The inner application gives its argument x level 2.","requires":[],"citationRequired":true}]},{"recordId":"teach-n0000773","units":[{"role":"definition","basis":"common_knowledge","text":"The occurrence level is the level assigned to an occurrence, and the replicator level is the level assigned to its replicator.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"The port delta is computed from two levels: the occurrence level and the replicator level.","requires":[],"citationRequired":true},{"role":"derivation","basis":"source","text":"Subtract the replicator level from the occurrence level to obtain the port delta: port delta = occurrence level − replicator level.","requires":[],"citationRequired":true}]}]}
