{"items":[{"recordId":"teach-n0001050","units":[{"role":"statement","basis":"source","text":"An eraser removes the distinct agent that it encounters.","requires":[],"citationRequired":true},{"role":"mechanism","basis":"source","text":"This deletion occurs because the eraser has no auxiliary ports through which it could preserve or redirect the agent's additional connections.","requires":[],"citationRequired":true}]},{"recordId":"teach-n0001051","units":[{"role":"statement","basis":"source","text":"Two distinct agents that are not erasers commute, meaning their order of interaction does not change the resulting structure.","requires":[],"citationRequired":true},{"role":"mechanism","basis":"source","text":"Their interaction produces outgoing copies, and the number of copies is determined by the number of auxiliary ports on the other agent.","requires":[],"citationRequired":true}]}]}
