  "items": [
    {
      "recordId": "teach-n0000698",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "Reduction can create fan-outs with the opposite orientation.",
          "requires": [
            "reduction",
            "fan-out",
            "orientation"
          ],
          "citationRequired": false
        },
        {
          "role": "intuition",
          "basis": "source",
          "text": "The fan-outs introduced by reduction need not retain the relevant orientation; they can have the opposite orientation.",
          "requires": [
            "reduction",
            "fan-out",
            "orientation"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000699",
      "units": [
        {
          "role": "definition",
          "basis": "common_knowledge",
          "text": "A fan-out is a pattern in which one element connects to multiple elements, while a fan-in is a pattern in which multiple elements connect to one element.",
          "requires": [],
          "citationRequired": false
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "A fan-out is paired upstream with at least one fan-in.",
          "requires": [
            "fan-out",
            "fan-in",
            "upstream"
          ],
          "citationRequired": false
        },
        {
          "role": "limitation",
          "basis": "source",
          "text": "The pairing is not required in the opposite direction: a fan-in may have no fan-out partner.",
          "requires": [
            "fan-in",
            "fan-out",
            "partner"
          ],
          "citationRequired": false
        }
      ]
    }
  ]
}
