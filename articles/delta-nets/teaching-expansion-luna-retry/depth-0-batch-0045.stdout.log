{"items":[{"recordId":"teach-n0001100","units":[{"role":"statement","basis":"source","text":"The prescribed schedule for reducing a nonlinear system first chooses a reducible pattern at the outermost applicable level.","requires":["reducible pattern","outermost position"],"citationRequired":false},{"role":"statement","basis":"source","text":"If multiple candidate patterns remain at that level, the schedule selects the candidate that appears farthest to the left.","requires":["reducible pattern","outermost position"],"citationRequired":false}]},{"recordId":"teach-n0001101","units":[{"role":"statement","basis":"source","text":"The schedule can permit a reducible pair to run before its normal turn instead of waiting for the ordinary selection step.","requires":["reducible pair","normal selection step"],"citationRequired":false},{"role":"limitation","basis":"source","text":"This early execution is allowed only when the pair will eventually reach leftmost-outermost position unchanged.","requires":["leftmost-outermost position"],"citationRequired":false}]}]}
