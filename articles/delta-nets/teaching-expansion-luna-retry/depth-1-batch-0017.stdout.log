{"items":[{"recordId":"teach-generated-bd6d9f96545b3410","units":[{"role":"definition","basis":"common_knowledge","text":"In a delta net, a fan interaction is the rewrite applied when two fan agents meet at their principal ports: both fans are removed, and their auxiliary ports are reconnected in matching pairs.","requires":["delta net","fan agent","principal port","auxiliary port","rewrite rule"],"citationRequired":false}]},{"recordId":"teach-generated-f80cad9e237894ad","units":[{"role":"definition","basis":"common_knowledge","text":"Auxiliary-port matching is the pairing of the remaining auxiliary ports after a fan interaction so that each pair can be reconnected by the rewrite rule.","requires":["auxiliary port","fan interaction","rewrite rule"],"citationRequired":false}]}]}
