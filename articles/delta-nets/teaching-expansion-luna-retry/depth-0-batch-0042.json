  "items": [
    {
      "recordId": "teach-n0001094",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "In ΔI and ΔK, the relevant objects are consecutive replicators.",
          "requires": [
            "ΔI",
            "ΔK",
            "replicator"
          ],
          "citationRequired": true
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "The consecutive replicators can merge when a local level test proves that the later replicator is unpaired.",
          "requires": [
            "local level test",
            "unpaired replicator"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0001095",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "For consecutive replicators A and B joined through delta d, let lA and lB denote their levels.",
          "requires": [
            "replicator",
            "consecutive replicators",
            "delta d"
          ],
          "citationRequired": true
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "B is known to be unpaired when its level difference from A satisfies the inequality 0 ≤ lB − lA ≤ d.",
          "requires": [
            "unpaired replicator",
            "level difference"
          ],
          "citationRequired": true
        }
      ]
    }
  ]
}
