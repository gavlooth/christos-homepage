{"items":[{"recordId":"teach-generated-74c4bd17b9109ba0","units":[{"role":"definition","basis":"common_knowledge","text":"In a Δ-net, an active replicator is a replicator agent currently interacting with another agent through its principal port.","requires":[],"citationRequired":false}]},{"recordId":"teach-generated-c7288ddeac130052","units":[{"role":"mechanism","basis":"common_knowledge","text":"Fan annihilation is the interaction in which two equal fan agents are canceled, and their corresponding auxiliary ports are reconnected.","requires":[],"citationRequired":false}]}]}
