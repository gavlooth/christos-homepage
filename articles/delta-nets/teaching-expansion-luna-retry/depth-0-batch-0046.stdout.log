{"items":[{"recordId":"teach-n0001102","units":[{"role":"statement","basis":"source","text":"The full algorithm first translates a term by applying φ, then reduces the resulting structure through proper nets.","requires":[],"citationRequired":true},{"role":"statement","basis":"source","text":"After reduction, the algorithm normalizes and canonicalizes the result with Ω, then reads the result back by applying the inverse translation φ⁻¹.","requires":[],"citationRequired":true}]},{"recordId":"teach-n0001103","units":[{"role":"statement","basis":"source","text":"Leftmost-outermost reduction chooses the leftmost available outer reduction before reducing inner subnets.","requires":[],"citationRequired":true},{"role":"mechanism","basis":"source","text":"This strategy avoids evaluating a subnet when a surrounding reduction will later erase that subnet, preventing unnecessary computation.","requires":[],"citationRequired":true}]}]}
