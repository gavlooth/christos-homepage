{"items":[{"recordId":"teach-n0000801","units":[{"role":"definition","basis":"common_knowledge","text":"The superscript −1 on a map symbol conventionally denotes an inverse map.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"The net can be read back using φ−1 only when it is normal.","requires":["normal net"],"citationRequired":true},{"role":"statement","basis":"source","text":"The net can be read back using φ−1 only when it is canonical.","requires":["canonical net"],"citationRequired":true}]},{"recordId":"teach-n0000805","units":[{"role":"definition","basis":"common_knowledge","text":"A β-reduction is one computational step in which an applied λ-abstraction is reduced by substituting its argument into the abstraction's body.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"When a λL term normalizes in n β-reductions, its ΔL encoding normalizes in n interactions as well.","requires":["ΔL encoding","interaction"],"citationRequired":true},{"role":"statement","basis":"source","text":"The ΔL encoding normalizes in n interactions regardless of the order of those interactions.","requires":["ΔL encoding","interaction"],"citationRequired":true}]}]}
