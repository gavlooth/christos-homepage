{"items":[{"recordId":"teach-n0001068","units":[{"role":"definition","basis":"common_knowledge","text":"A free variable is a variable occurrence that is not bound by a binder in its syntactic context.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"A free variable becomes a named boundary node.","requires":["named boundary node"],"citationRequired":false},{"role":"limitation","basis":"source","text":"A free variable is not a rewriting agent.","requires":["rewriting agent"],"citationRequired":false}]}]}
