      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "The replicator stores a sharing context using a level attached to the agent itself.",
          "requires": [
            "replicator",
            "sharing context",
            "level"
          ],
          "citationRequired": true
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "It also stores a delta separately on each auxiliary port. The sharing context therefore has one agent-level value and a port-specific value for every auxiliary port.",
          "requires": [
            "delta",
            "auxiliary port",
            "sharing context"
          ],
          "citationRequired": true
        }
      ]
    }
  ]
