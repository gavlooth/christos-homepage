{"items":[{"recordId":"teach-n0000685","units":[{"role":"statement","basis":"source","text":"The replicator stores a sharing context as a level on the agent.","requires":["replicator","sharing context","level","agent"],"citationRequired":true},{"role":"statement","basis":"source","text":"The replicator stores a delta on each auxiliary port.","requires":["replicator","delta","auxiliary port"],"citationRequired":true}]},{"recordId":"teach-n0000691","units":[{"role":"statement","basis":"source","text":"Fans encode structure, while erasers encode omission.","requires":["fan","structure","eraser","omission"],"citationRequired":true},{"role":"statement","basis":"source","text":"Replicators encode sharing.","requires":["replicator","sharing"],"citationRequired":true}]},{"recordId":"teach-n0000692","units":[{"role":"statement","basis":"source","text":"Equal replicators must have the same level and arity.","requires":["replicator","level","arity"],"citationRequired":true},{"role":"statement","basis":"source","text":"Equal replicators must also have matching deltas on every port.","requires":["replicator","delta","port"],"citationRequired":true}]},{"recordId":"teach-n0000693","units":[{"role":"statement","basis":"source","text":"For a well-formed λ-term translation, consider active replicators that are at the same level.","requires":["well-formed λ-term translation","active replicator","level"],"citationRequired":true},{"role":"statement","basis":"source","text":"Under those conditions, the same-level active replicators are equal.","requires":["active replicator","level","equality"],"citationRequired":true}]},{"recordId":"teach-n0000696","units":[{"role":"statement","basis":"source","text":"Parent and child are labels that describe a wire's orientation.","requires":["parent","child","wire","orientation"],"citationRequired":true},{"role":"statement","basis":"source","text":"The orientation labels parent and child are assigned relative to the root.","requires":["parent","child","orientation","root"],"citationRequired":true}]},{"recordId":"teach-n0000697","units":[{"role":"statement","basis":"source","text":"Canonical nets begin with fan-in replicators that are unpaired.","requires":["canonical net","fan-in replicator","unpaired"],"citationRequired":true},{"role":"statement","basis":"source","text":"The auxiliaries of these replicators are parents, and their principal is a child.","requires":["fan-in replicator","auxiliary","principal","parent","child"],"citationRequired":true}]},{"recordId":"teach-n0000698","units":[{"role":"statement","basis":"source","text":"Reduction can create fan-outs.","requires":["reduction","fan-out"],"citationRequired":true},{"role":"statement","basis":"source","text":"The fan-outs created by reduction can have the opposite orientation.","requires":["reduction","fan-out","orientation"],"citationRequired":true}]},{"recordId":"teach-n0000699","units":[{"role":"statement","basis":"source","text":"A fan-out is paired upstream with at least one fan-in.","requires":["fan-out","fan-in","upstream","paired"],"citationRequired":true},{"role":"statement","basis":"source","text":"A fan-in does not need to have a partner.","requires":["fan-in","partner"],"citationRequired":true}]}]}
