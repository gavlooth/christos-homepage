{
  "depth": 0,
  "batch": 10,
  "items": [
    {
      "recordId": "teach-n0000811",
      "units": [
        {
          "role": "definition",
          "basis": "source",
          "text": "A Δ-Net encodes each sharing context using a replicator.",
          "requires": [],
          "citationRequired": false
        },
        {
          "role": "definition",
          "basis": "source",
          "text": "The replicator has variable arity, meaning that its number of sharing connections is not fixed in advance.",
          "requires": [
            "replicator"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000812",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "Reduction combines local interactions between nearby structures.",
          "requires": [],
          "citationRequired": false
        },
        {
          "role": "limitation",
          "basis": "source",
          "text": "Reduction also uses a limited amount of global scheduling discipline to coordinate those local interactions.",
          "requires": [
            "local interaction"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0001027",
      "units": [
        {
          "role": "definition",
          "basis": "source",
          "text": "Applying a lambda abstraction λx. t to an argument u forms the expression (λx. t) u.",
          "requires": [
            "lambda abstraction",
            "function application"
          ],
          "citationRequired": false
        },
        {
          "role": "derivation",
          "basis": "source",
          "text": "The application reduces according to (λx. t) u → t[x := u].",
          "requires": [
            "substitution"
          ],
          "citationRequired": false
        },
        {
          "role": "definition",
          "basis": "common_knowledge",
          "text": "The substitution t[x := u] replaces free occurrences of x in t with u while avoiding capture of variables in u by surrounding binders.",
          "requires": [
            "free occurrence",
            "variable capture"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0001030",
      "units": [
        {
          "role": "definition",
          "basis": "source",
          "text": "A share component is an intermediate component through which a value or resource can be used.",
          "requires": [],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "Two uses can connect to one intermediate share component, so they share that component rather than using separate intermediate components.",
          "requires": [
            "sharing"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0001032",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "An interaction step acts on an active pair of agents.",
          "requires": [
            "active pair",
            "agent"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "The step either removes the active pair or lets it pass through while reconnecting nearby wires.",
          "requires": [
            "active pair",
            "wire"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0001033",
      "units": [
        {
          "role": "definition",
          "basis": "source",
          "text": "Each agent has one principal port, which is the port used to identify its principal interaction connection.",
          "requires": [
            "agent",
            "port"
          ],
          "citationRequired": false
        },
        {
          "role": "derivation",
          "basis": "source",
          "text": "Distinct active pairs never share an agent because an agent's single principal port cannot participate in two distinct active pairs.",
          "requires": [
            "active pair"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0001034",
      "units": [
        {
          "role": "definition",
          "basis": "source",
          "text": "Perfect confluence means that alternative interaction choices can be reconciled to a common result.",
          "requires": [
            "confluence"
          ],
          "citationRequired": false
        },
        {
          "role": "derivation",
          "basis": "source",
          "text": "Its one-step diamond property says that two possible steps from N reach a common net after one additional interaction from each resulting net.",
          "requires": [
            "net",
            "interaction step"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0001035",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "Distinct active-pair rewrites commute, so either rewrite may be performed first.",
          "requires": [
            "active pair",
            "rewrite"
          ],
          "citationRequired": false
        },
        {
          "role": "derivation",
          "basis": "source",
          "text": "They commute because they use distinct agents and leave the same nearby wiring regardless of which rewrite is performed first.",
          "requires": [
            "agent",
            "wire"
          ],
          "citationRequired": false
        }
      ]
    }
  ]
}
