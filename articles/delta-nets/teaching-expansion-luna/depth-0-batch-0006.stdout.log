{"items":[{"recordId":"teach-n0000748","units":[{"role":"statement","basis":"source","text":"A replicator connects to the abstraction’s variable port.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"The replicator connects that variable port to multiple concrete use sites.","requires":[],"citationRequired":false},{"role":"definition","basis":"common_knowledge","text":"A replicator is a graph node that copies one incoming connection into multiple outgoing connections.","requires":[],"citationRequired":false}]},{"recordId":"teach-n0000749","units":[{"role":"statement","basis":"source","text":"For λx.x x, the two replicator auxiliaries correspond to the two uses of x.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"One auxiliary connects to the application’s argument port, and the other connects to its function port.","requires":[],"citationRequired":false}]},{"recordId":"teach-n0000750","units":[{"role":"statement","basis":"source","text":"The representation omits a one-port zero-delta replicator.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"The omitted replicator is equivalent to a wire.","requires":[],"citationRequired":false}]},{"recordId":"teach-n0000753","units":[{"role":"statement","basis":"source","text":"An unused parameter has a parameter port.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"In both ΔA and ΔK, that parameter port terminates at an eraser.","requires":[],"citationRequired":false}]},{"recordId":"teach-n0000754","units":[{"role":"statement","basis":"source","text":"The single-use case has one concrete use of the parameter.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"That use connects directly to the parameter port.","requires":[],"citationRequired":false},{"role":"intuition","basis":"common_knowledge","text":"A direct connection is sufficient when no duplication is required.","requires":[],"citationRequired":false}]},{"recordId":"teach-n0000755","units":[{"role":"statement","basis":"source","text":"The multiple-use case has more than one concrete use of the parameter.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"Those uses connect through a replicator.","requires":[],"citationRequired":false},{"role":"intuition","basis":"common_knowledge","text":"A replicator supplies separate outgoing connections for the parameter’s distinct uses.","requires":[],"citationRequired":false}]},{"recordId":"teach-n0000757","units":[{"role":"statement","basis":"source","text":"In λx.x x, the body port connects to the application result.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"The replicator ports connect to the application’s function and argument ports.","requires":[],"citationRequired":false}]},{"recordId":"teach-n0000761","units":[{"role":"statement","basis":"source","text":"The wiring places an abstraction on the function side of an application.","requires":[],"citationRequired":false},{"role":"statement","basis":"source","text":"This placement lets the abstraction form a β-redex.","requires":[],"citationRequired":false},{"role":"definition","basis":"common_knowledge","text":"A β-redex is an application whose function is an abstraction and can therefore undergo β-reduction.","requires":[],"citationRequired":false}]}]}
