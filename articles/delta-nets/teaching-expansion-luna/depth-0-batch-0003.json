{
  "depth": 0,
  "batch": 3,
  "items": [
    {
      "recordId": "teach-n0000703",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "In a well-formed λ translation, active replicators at the same level annihilate.",
          "requires": [
            "well-formed λ translation",
            "active replicator"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "After the same-level replicators annihilate, matching auxiliary ports reconnect.",
          "requires": [
            "auxiliary port"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000704",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "Fan annihilation is an interaction in the graph representation of λ-calculus.",
          "requires": [
            "fan annihilation"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "That interaction represents applying a λ abstraction to its argument.",
          "requires": [
            "λ abstraction",
            "argument"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000707",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "A two-port fan can meet an eraser in an interaction.",
          "requires": [
            "two-port fan",
            "eraser"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "After this interaction, two erasers remain connected to the fan’s auxiliary outputs.",
          "requires": [
            "auxiliary output"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000708",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "An n-port replicator can meet an eraser in an interaction.",
          "requires": [
            "n-port replicator",
            "eraser"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "After this interaction, an eraser remains at each of the replicator’s n outputs, leaving n erasers.",
          "requires": [
            "replicator output"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000711",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "Wire orientation gives the direction of a wire relative to the graph’s root.",
          "requires": [
            "wire orientation",
            "root"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "The roles of the graph elements are identified from that orientation relative to the root.",
          "requires": [
            "graph element role"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000712",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "A principal-to-principal fan interaction removes both participating fans.",
          "requires": [
            "principal port",
            "fan interaction"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "It then reconnects auxiliary ports that match one another.",
          "requires": [
            "auxiliary port matching"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000717",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "The upward-rotated abstraction fan has auxiliary ports with a specified right-to-left order.",
          "requires": [
            "upward-rotated abstraction fan",
            "auxiliary port order"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "In that order, the first auxiliary is on the right and the second auxiliary is to its left.",
          "requires": [
            "first auxiliary",
            "second auxiliary"
          ],
          "citationRequired": false
        }
      ]
    },
    {
      "recordId": "teach-n0000718",
      "units": [
        {
          "role": "mechanism",
          "basis": "source",
          "text": "Semantic port indices identify corresponding ports by their roles in the represented structure.",
          "requires": [
            "semantic port index"
          ],
          "citationRequired": false
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "Consequently, connections for matching semantic port indices may correspond to wires that cross in the drawing.",
          "requires": [
            "matching semantic port indices",
            "drawn wire"
          ],
          "citationRequired": false
        }
      ]
    }
  ]
}
