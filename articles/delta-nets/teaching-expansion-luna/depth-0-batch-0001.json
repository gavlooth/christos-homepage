{
  "depth": 0,
  "batch": 1,
  "items": [
    {
      "recordId": "teach-n0000660",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "The model performs the necessary work for an expression only once.",
          "requires": [
            "expression"
          ],
          "citationRequired": true
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "This remains true even when the same expression is used multiple times.",
          "requires": [
            "expression use"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000663",
      "units": [
        {
          "role": "definition",
          "basis": "source",
          "text": "The one-step diamond property compares two results produced by taking different one-step interactions.",
          "requires": [
            "one-step interaction",
            "one-step result"
          ],
          "citationRequired": true
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "It requires either one-step result to reach a common net after one further interaction.",
          "requires": [
            "net"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000667",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "Rewrites of two distinct active pairs commute, so performing them in either order gives the same result.",
          "requires": [
            "rewrite",
            "active pair"
          ],
          "citationRequired": true
        },
        {
          "role": "mechanism",
          "basis": "source",
          "text": "The rewrites preserve the same nearby wiring because each rewrite acts on its own distinct active pair.",
          "requires": [
            "nearby wiring"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000671",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "For a normalizing core interaction order, every interaction order that normalizes reaches the same result.",
          "requires": [
            "normalizing interaction order",
            "normalizing order",
            "result"
          ],
          "citationRequired": true
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "Every such normalizing order reaches that result after the same number of interactions.",
          "requires": [
            "interaction"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000673",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "Earlier approaches represented each sharing scope with indexed fans.",
          "requires": [
            "sharing scope",
            "indexed fan"
          ],
          "citationRequired": true
        },
        {
          "role": "statement",
          "basis": "source",
          "text": "Those approaches also used delimiter agents as part of the representation for each sharing scope.",
          "requires": [
            "delimiter agent",
            "sharing scope"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000675",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "Delimiter interactions could occur more frequently than the useful fan-work interactions.",
          "requires": [
            "delimiter interaction",
            "fan work"
          ],
          "citationRequired": true
        },
        {
          "role": "limitation",
          "basis": "source",
          "text": "Thus, the interaction count could be dominated by delimiter handling rather than by useful fan work.",
          "requires": [
            "interaction count"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000678",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "Application fans and function fans are represented as triangles.",
          "requires": [
            "application fan",
            "function fan"
          ],
          "citationRequired": true
        },
        {
          "role": "definition",
          "basis": "source",
          "text": "Each triangle has a top principal port and two fixed auxiliary positions at the bottom.",
          "requires": [
            "principal port",
            "auxiliary position"
          ],
          "citationRequired": true
        }
      ]
    },
    {
      "recordId": "teach-n0000679",
      "units": [
        {
          "role": "statement",
          "basis": "source",
          "text": "Replicators are represented as trapezoids.",
          "requires": [
            "replicator"
          ],
          "citationRequired": true
        },
        {
          "role": "definition",
          "basis": "source",
          "text": "Each replicator has a centered principal port at the top and evenly spaced auxiliary ports along the bottom.",
          "requires": [
            "principal port",
            "auxiliary port"
          ],
          "citationRequired": true
        }
      ]
    }
  ]
}
