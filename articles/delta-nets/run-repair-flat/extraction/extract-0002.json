    },
    {
      "kind": "source",
      "text": "flowchart TB\nres2@{ shape: rect, label: \"result · 1st\" }\narg2@{ shape: rect, label: \"argument · 2nd\" }\nbody2@{ shape: rect, label: \"body · 1st\" }\nvar2@{ shape: rect, label: \"variable · 2nd\" }\nres2 -->|1st ↔ 1st| body2\narg2 -->|2nd ↔ 2nd| var2",
      "sourceUnitIds": [
        "u000165"
