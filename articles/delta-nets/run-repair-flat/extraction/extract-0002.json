      ]
    },
    {
      "kind": "source",
      "text": "flowchart TB\nE1[\"E\"]\nE2[\"E\"]\nM2[\"subnet M\"]\nN2[\"subnet N\"]\nE1 --> M2\nE2 --> N2",
      "sourceUnitIds": [
        "u000159"
      ],
      "defines": [],
      "requires": [],
