    {
      "kind": "topic",
      "text": "### 2.1 Graphs make sharing visible",
      "sourceUnitIds": [
        "u000082"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
      "chunkId": "c0001-flat-06",
      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "A syntax tree treats every occurrence as its own copy. A graph can let several uses point at one shared subgraph—a connected piece of the larger graph. That is the essential move: compute the shared piece once, then reuse it.",
      "sourceUnitIds": [
        "u000083"
      ],
      "defines": [],
