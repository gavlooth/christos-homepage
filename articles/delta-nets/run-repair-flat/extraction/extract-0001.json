    {
      "kind": "topic",
      "text": "#### Levels & Δ",
      "sourceUnitIds": [
        "u000035"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
      "chunkId": "c0001-flat-03",
      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "Levels track nested abstractions. Each level shift adds a cost (a \"delta\") when a variable travels through a lambda. This is how we keep track of scopes without global lookups.",
      "sourceUnitIds": [
        "u000036"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
