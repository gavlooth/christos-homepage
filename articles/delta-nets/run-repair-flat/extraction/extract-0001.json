    {
      "kind": "source",
      "text": "The paper leaves the sequential substitution machine behind and moves to an interaction system: a graph whose tiny local rewrites can happen independently. First, pin down what “local” and “independent” mean here.",
      "sourceUnitIds": [
        "u000081"
      ],
