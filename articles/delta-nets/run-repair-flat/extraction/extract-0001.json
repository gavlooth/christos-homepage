    {
      "kind": "topic",
      "text": "#### Bound vs. free",
      "sourceUnitIds": [
        "u000033"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
