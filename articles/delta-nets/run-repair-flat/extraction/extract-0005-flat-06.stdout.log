{"nodes":[{"kind":"mapping","text":"ΔA handles discarded subnet garbage with leftmost-outermost annihilation and erasure canonicalization.","sourceUnitIds":["u000381"],"defines":["ΔA"],"requires":["leftmost-outermost annihilation","erasure canonicalization"],"mentions":["discarded subnet garbage"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"mapping","text":"ΔI handles replicator trees and early copies with leftmost-outermost reduction, unpaired merging, and canonicalization.","sourceUnitIds":["u000382"],"defines":["ΔI"],"requires":["leftmost-outermost reduction","unpaired merging","canonicalization"],"mentions":["replicator trees","early copies"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"mapping","text":"ΔK handles both garbage and sharing context with leftmost-outermost reduction plus erasure, merge, and decay canonicalizations.","sourceUnitIds":["u000383"],"defines":["ΔK"],"requires":["leftmost-outermost reduction","erasure canonicalization","merge canonicalization","decay canonicalization"],"mentions":["garbage","sharing context"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"heading","text":"A useful way to separate the claims","sourceUnitIds":["u000384"],"defines":[],"requires":[],"mentions":["claims"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"Every term in the four lambda-calculus fragments has a canonical net through a stated bijection.","sourceUnitIds":["u000385"],"defines":["expressiveness"],"requires":["canonical net","stated bijection"],"mentions":["four lambda-calculus fragments"],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim","text":"The three-agent core is an interaction system with the one-step diamond property.","sourceUnitIds":["u000386"],"defines":["local behavior","one-step diamond property"],"requires":["three-agent core","interaction system"],"mentions":[],"fills":[],"need":"","gapType":null,"origin":"source"},{"kind":"claim",