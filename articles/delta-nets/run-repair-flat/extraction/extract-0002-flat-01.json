    },
    {
      "kind": "source",
      "text": "flowchart TB\nN((N))\nN1((N₁))\nN2((N₂))\nM((M))\nN -->|one interaction| N1\nN -->|one interaction| N2\nN1 -->|one interaction| M\nN2 -->|one interaction| M",
      "sourceUnitIds": [
