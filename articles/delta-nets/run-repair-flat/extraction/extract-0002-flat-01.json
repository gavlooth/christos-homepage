    {
      "kind": "topic",
      "text": "### Agreement and termination are separate questions",
      "sourceUnitIds": [
        "u000108"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
