      ]
    },
    {
      "kind": "topic",
      "text": "### 6.2 Erasure needs a root-reachability sweep",
      "sourceUnitIds": [
        "u000325"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
