    {
      "kind": "source",
      "text": "flowchart TB\nrootC((root))\nkeep2[\"reachable subnet\"]\nEcap[\"E · exposed wires\"]\nrootC --> keep2\nkeep2 -.-> Ecap",
      "sourceUnitIds": [
        "u000339"
