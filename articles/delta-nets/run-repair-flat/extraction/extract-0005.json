    {
      "kind": "topic",
      "text": "### Choose the space/time trade-off",
      "sourceUnitIds": [
        "u000334"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
