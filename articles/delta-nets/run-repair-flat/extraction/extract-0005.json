      "chunkId": "c0005-flat-01",
      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "Walk parent–child wires from the root and mark every node you reach.",
      "sourceUnitIds": [
        "u000329"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
