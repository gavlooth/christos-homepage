      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "In ΔA and ΔK, an eraser can leave disconnected subnets—smaller graph regions—behind. Erasure canonicalization gathers that unreachable material in one reachability sweep:",
      "sourceUnitIds": [
        "u000326"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
      "chunkId": "c0005-flat-01",
      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "A",
      "sourceUnitIds": [
        "u000327"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
      "chunkId": "c0005-flat-01",
      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "topic",
      "text": "### Mark from the root",
      "sourceUnitIds": [
        "u000328"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
