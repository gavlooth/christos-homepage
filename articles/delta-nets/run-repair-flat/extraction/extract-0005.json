      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "1 · Proper net with a detached island",
      "sourceUnitIds": [
        "u000336"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
