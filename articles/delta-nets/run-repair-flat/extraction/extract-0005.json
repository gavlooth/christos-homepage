      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "topic",
      "text": "### 6.1 Canonical and proper are different states",
      "sourceUnitIds": [
        "u000320"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
      "chunkId": "c0005-flat-01",
      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "Translation produces a canonical net: the standard shape the reverse translation knows how to read. After zero or more core interactions you have a proper net—any intermediate shape reachable during reduction. Canonicalization is the cleanup that walks a proper net back to canonical form.",
      "sourceUnitIds": [
        "u000321"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
      "chunkId": "c0005-flat-01",
      "annotations": [
        "repair_source_fallback"
      ]
    },
    {
      "kind": "source",
      "text": "State | Meaning in the paper | Why a reader should care | |",
      "sourceUnitIds": [
        "u000322"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
      "chunkId": "c0005-flat-01",
      "annotations": [
