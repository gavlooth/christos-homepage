    {
      "kind": "topic",
      "text": "### The \"Why\" of Deltas",
      "sourceUnitIds": [
        "u000044"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source",
