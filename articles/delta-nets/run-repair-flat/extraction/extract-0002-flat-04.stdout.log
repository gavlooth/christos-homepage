    },
    {
      "kind": "claim",
      "text": "ΔL permits fans and corresponds to the linear fragment, where each resource is used exactly once.",
      "sourceUnitIds": ["u000139"],
      "defines": ["ΔL"],
      "requires": ["fan", "linear fragment"],
      "mentions": ["exactly one use"],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "ΔA permits fans and erasers and corresponds to the affine fragment, where a use may be absent.",
      "sourceUnitIds": ["u000140"],
      "defines": ["ΔA"],
      "requires": ["fan", "eraser", "affine fragment"],
      "mentions": ["optional use"],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "ΔI permits fans and replicators and corresponds to the relevant fragment, where a use may repeat.",
      "sourceUnitIds": ["u000141"],
      "defines": ["ΔI"],
      "requires": ["fan", "replicator", "relevant fragment"],
      "mentions": ["repeated use"],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "ΔK permits fans, erasers, and replicators and corresponds to the full fragment, where absence and repetition are both allowed.",
      "sourceUnitIds": ["u000142"],
      "defines": ["ΔK"],
      "requires": ["fan", "eraser", "replicator", "full fragment"],
      "mentions": ["optional use", "repeated use"],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "definition",
      "text": "Linear usage means exactly one bound use.",
      "sourceUnitIds": ["u000143"],
      "defines": ["linear usage"],
      "requires": ["bound use"],
      "mentions": ["ΔL"],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "definition",
      "text": "Affine usage means at most one bound use.",
      "sourceUnitIds": ["u000143"],
      "defines": ["affine usage"],
      "requires": ["bound use"],
      "mentions": ["ΔA"],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "definition",
      "text": "Relevant usage means at least one bound use.",
