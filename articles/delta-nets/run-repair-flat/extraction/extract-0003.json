      ]
    },
    {
      "kind": "source",
      "text": "flowchart TB\nabs[\"λx.M · parameter x · body M\"]\napp[\"M N · function M · argument N\"]\nocc[\"x₀ and x₁ · two uses of x\"]",
      "sourceUnitIds": [
        "u000221"
      ],
      "defines": [],
