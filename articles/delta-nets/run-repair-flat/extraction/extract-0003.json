    {
      "kind": "source",
      "text": "“Duplicate” means exact copies. “Replicate” is the paper’s word for copies that may differ by level. That distinction does real work: it replaces the separate indexed delimiters of older systems. A delta may be negative, zero, or positive; this example sticks to zero and a positive value only to keep the arithmetic easy to see.",
      "sourceUnitIds": [
        "u000213"
      ],
      "defines": [],
      "requires": [],
