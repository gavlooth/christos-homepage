ices.","densityScore":0.93,"confidence":"high"},{"text":"go-mHC is a manifold-constrained hyper-connection method that directly parameterizes generalized orthostochastic stream-mixing matrices, with block parameter s controlling expressivity.","densityScore":0.94,"confidence":"high"}]},{"gapId":"n0000209","nodes":[{"text":"H_res is the residual-stream mixing operator or space of possible mixing terms used by a hyper-connection across d residual streams.","densityScore":0.77,"confidence":"medium"}]},{"gapId":"n0000210","nodes":[{"text":"d-streams are the d parallel residual streams whose representations are mixed by a hyper-connection matrix.","densityScore":0.9,"confidence":"high"}]},{"gapId":"n0000212","nodes":[{"text":"The spectral hull of a matrix class is the region of the complex plane containing all eigenvalues attainable by matrices in that class.","densityScore":0.9,"confidence":"high"}]},{"gapId":"n0000213","nodes":[{"text":"i_k is the dimension of each base factor in a k-fold Kronecker parameterization; here i_k=2 means the construction uses 2×2 factors.","densityScore":0.78,"confidence":"medium"}]}]}
