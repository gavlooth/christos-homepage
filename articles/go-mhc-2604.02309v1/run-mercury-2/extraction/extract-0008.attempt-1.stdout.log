    },
    {
      "kind": "claim",
      "text": "For d = 16, go‑mHC is 16 orders of magnitude slower than mHC‑lite.",
      "sourceUnitIds": [
        "u000093"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
