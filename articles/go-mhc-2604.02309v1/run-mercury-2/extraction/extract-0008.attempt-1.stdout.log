    {
      "kind": "claim",
      "text": "KromHC and mHC-lite show significant speed‑ups because they remove iterative updates.",
      "sourceUnitIds": [
        "u000093"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "For d = 16, go‑mHC is 22 orders of magnitude slower than KromHC.",
      "sourceUnitIds": [
        "u000093"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
