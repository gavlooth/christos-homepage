      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "Model performance improvements generally outweigh computational cost, but scaling residual streams eventually hits a practical limit; go‑mHC aims to provide a middle‑ground balance between FLOP cost and expressivity.",
      "sourceUnitIds": [
        "u000094"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "go‑mHC offers a practical middle‑ground FLOP complexity for scaling residual streams, avoiding the super‑exponential cost of mHC‑lite and the iterative overhead of mHC SK iterations; nominal constants are S = 20, i_k = 2, and s ∈ {1,2}. See Appendix B.6 for full estimates.",
      "sourceUnitIds": [
        "u000095"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "mHC FLOP complexity per layer is O(C·S·d²).",
