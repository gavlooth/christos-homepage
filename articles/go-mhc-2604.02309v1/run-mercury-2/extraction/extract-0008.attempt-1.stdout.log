    },
    {
      "kind": "claim",
      "text": "go‑mHC has roughly the same order of magnitude in FLOP complexity as mHC with Sinkhorn‑Knopp iterations because O(d) ≈ O(S).",
      "sourceUnitIds": [
        "u000093"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
