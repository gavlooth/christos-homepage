    {
      "kind": "claim",
      "text": "A mapping M with high spectral reach generates matrices that span a larger volume of the Karpelevič region, the compact subset of the unit disk containing all possible eigenvalues of stochastic matrices.",
      "sourceUnitIds": [
        "u000075"
      ],
      "defines": [],
