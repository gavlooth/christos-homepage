    {
      "kind": "claim",
      "text": "We do not rely on the AGM metric because the exactness of P_go makes it equal to 1 by definition.",
      "sourceUnitIds": [
        "u000068"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": null,
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "B_d is closed under matrix multiplication, so H_{l→L}^{res} remains doubly stochastic regardless of depth.",
      "sourceUnitIds": [
        "u000068"
      ],
      "defines": [],
      "requires": [],
      "mentions": [],
      "fills": [],
      "need": null,
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "go-mHC, mHC-lite, and KromHC all achieve the same performance on the AGM metric, so we evaluate expressivity and convergence as additional metrics.",
