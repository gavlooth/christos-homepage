    {
      "kind": "claim",
      "text": "Doubly stochastic matrices enable learned mixing across residual streams.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [],
      "requires": [],
      "mentions": [
        "doubly stochastic matrices",
        "residual streams"
      ],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "Parameterizing the Birkhoff polytope exactly and efficiently remains an open challenge.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [],
      "requires": [
        "Birkhoff polytope"
      ],
      "mentions": [
        "exact parameterization",
        "efficiency"
      ],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "Existing exact methods scale factorially with the number of streams d, while Kronecker-factorized approaches are efficient but have limited expressivity.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [],
      "requires": [
        "Kronecker-factorized approaches"
      ],
      "mentions": [
        "factorial scaling",
        "expressivity"
      ],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "We introduce a novel exact parameterization based on generalized orthostochastic matrices, scaling as O(d³) and exposing a hyperparameter s that interpolates between a computationally efficient boundary and the fully expressive Birkhoff polytope.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [
        "generalized orthostochastic matrices",
        "hyperparameter s"
      ],
      "requires": [
        "Birkhoff polytope"
      ],
      "mentions": [
        "O(d³) scaling"
      ],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "Our method composes naturally with Kronecker-factorized methods, substantially recovering expressivity at similar FLOP costs.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [],
      "requires": [
        "Kronecker-factorized methods"
      ],
      "mentions": [
        "expressivity",
        "FLOP costs"
      ],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "Spectral analysis indicates that go-mHC fills the Birkhoff polytope far more completely than Kronecker-factorized baselines.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [],
      "requires": [
        "Birkhoff polytope"
      ],
      "mentions": [
        "spectral analysis",
        "Kronecker-factorized baselines"
      ],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "On synthetic stream-mixing tasks, go-mHC achieves the minimum theoretical loss while converging up to 10× faster.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [],
      "requires": [
        "synthetic stream-mixing tasks"
      ],
      "mentions": [
        "minimum theoretical loss",
        "10× faster convergence"
      ],
      "fills": [],
      "need": "",
      "gapType": null,
      "origin": "source"
    },
    {
      "kind": "claim",
      "text": "We validate our approach in a 30M parameter GPT-style language model.",
      "sourceUnitIds": [
        "u000011"
      ],
      "defines": [],
      "requires": [
        "GPT-style language model"
      ],
      "mentions": [
        "30M parameters"
      ],
      "fills": [],
      "need": "",
