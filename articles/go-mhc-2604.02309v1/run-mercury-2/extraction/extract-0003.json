    {
      "kind": "definition",
      "text": "A matrix B in 𝖡d is orthostochastic when there exists an orthogonal Q such that each entry B_ij equals Q_ij squared.",
      "need": "",
      "gapType": null,
      "sourceUnitIds": [
        "u000054"
      ],
      "defines": [
        "orthostochastic matrix"
      ],
      "requires": [],
      "mentions": [],
      "fills": [],
      "origin": "source",
      "chunkId": "c0003"
    },
    {
      "kind": "claim",
      "text": "For dimension n≥3, orthostochastic matrices form a proper non‑convex subset of 𝖡d.",
      "need": "",
      "gapType": null,
      "sourceUnitIds": [
        "u000054"
      ],
      "defines": [],
      "requires": [
        "orthostochastic matrix"
      ],
      "mentions": [],
      "fills": [],
      "origin": "source",
      "chunkId": "c0003"
    },
    {
      "kind": "definition",
      "text": "Q, an orthogonal matrix of size ds, can be seen as a d×d block matrix where each block Q_ij is s×s.",
      "need": "",
      "gapType": null,
      "sourceUnitIds": [
        "u000055"
      ],
      "defines": [
        "block matrix q"
      ],
      "requires": [],
      "mentions": [],
      "fills": [],
      "origin": "source",
      "chunkId": "c0003"
    },
    {
      "kind": "definition",
      "text": "Φ_{d,s}(Q)_{ij} equals the average squared Frobenius norm of block Q_ij, i.e., (1/s) Σ_{k,l}(Q_ij)_{kl}^2.",
      "need": "",
      "gapType": null,
      "sourceUnitIds": [
        "u000056"
      ],
      "defines": [
        "φ{d,s}(q){ij}"
      ],
      "requires": [],
      "mentions": [],
      "fills": [],
      "origin": "source",
      "chunkId": "c0003"
    },
    {
